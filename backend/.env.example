PORT=5000
NODE_ENV=development

# Frontend origin (used for CORS and links in emails, e.g. password reset)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Brevo (https://app.brevo.com -> SMTP & API -> API keys). Sender email must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=InviteOnline

# Cloudinary (https://console.cloudinary.com -> Dashboard)
# Easiest: paste the whole "API environment variable" from the Console instead of the three keys below:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


